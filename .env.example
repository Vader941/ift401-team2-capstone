# Copy this file to .env for local development.
# Never place real secrets in this example or commit your local .env file.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hosted database values will be documented when deployment is configured.
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
